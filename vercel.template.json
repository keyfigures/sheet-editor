{
  "cleanUrls": false,
  "rewrites": [{ "source": "/editor", "destination": "/editor.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' __APP_ORIGIN__; connect-src 'self' blob: data:; img-src 'self' data: blob:" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.wasm\\.br",
      "headers": [{ "key": "Content-Encoding", "value": "br" }]
    },
    {
      "source": "/fonts/([0-9]+)",
      "headers": [{ "key": "Content-Type", "value": "font/ttf" }]
    }
  ]
}
