diff --git a/lib/onlyoffice/guards/kf-lock.ts b/lib/onlyoffice/guards/kf-lock.ts
new file mode 100644
index 0000000..14d03e5
--- /dev/null
+++ b/lib/onlyoffice/guards/kf-lock.ts
@@ -0,0 +1,64 @@
+import { isEmbedMode } from '../../embed-mode';
+
+/**
+ * The viewer's lock beyond the editor's own view restriction, which leaves the sheet strip live: its menu still
+ * offered Insert, Delete, Rename, Hide and Move on a locked file. So the strip's menu and double-click stop here, and
+ * the calls that change the sheet list do nothing, however they are reached. Print and save have no place in a viewer.
+ */
+const SHEET_LIST_CALLS = [
+  'asc_addWorksheet',
+  'asc_insertWorksheet',
+  'asc_deleteWorksheet',
+  'asc_moveWorksheet',
+  'asc_copyWorksheet',
+  'asc_renameWorksheet',
+  'asc_hideWorksheet',
+  'asc_unhideWorksheet',
+  'asc_setWorksheetTabColor',
+];
+const SHEET_STRIP = '#status-sheets-bar-box, #status-tabs-scroll';
+
+function stop(event: Event): void {
+  event.preventDefault();
+  event.stopImmediatePropagation();
+}
+
+export function swallowPrintAndSave(doc: Document): void {
+  doc.addEventListener(
+    'keydown',
+    (event) => {
+      const key = event.key.toLowerCase();
+      if ((event.metaKey || event.ctrlKey) && (key === 'p' || key === 's')) stop(event);
+      // On the grid it would be the browser's Back: in WebKit the whole viewer navigated away. A locked file has nothing
+      // to delete, and the boxes that take typing keep it.
+      const target = event.target as HTMLElement | null;
+      const box = target?.id === 'ce-cell-content' || target?.tagName === 'INPUT';
+      if (key === 'backspace' && !box) event.preventDefault();
+    },
+    { capture: true },
+  );
+}
+
+export function installKfLock(win: Window): boolean {
+  if (!isEmbedMode()) return true;
+  const w = win as unknown as { Asc?: { editor?: Record<string, unknown> }; __kfLocked?: boolean };
+  const api = w.Asc?.editor;
+  if (!api) return false;
+  if (w.__kfLocked) return true;
+  w.__kfLocked = true;
+  for (const name of SHEET_LIST_CALLS) {
+    if (typeof api[name] === 'function') api[name] = () => false;
+  }
+  const doc = win.document;
+  swallowPrintAndSave(doc);
+  for (const type of ['contextmenu', 'dblclick', 'dragstart']) {
+    doc.addEventListener(
+      type,
+      (event) => {
+        if ((event.target as Element | null)?.closest?.(SHEET_STRIP)) stop(event);
+      },
+      { capture: true },
+    );
+  }
+  return true;
+}
