+/** This page's half of the guard in the editor's own index.html: no focus until the reader touches the viewer. */
+function guardFocus(): void {
+  let touched = false;
+  for (const type of ['pointerdown', 'mousedown', 'touchstart', 'keydown']) {
+    window.addEventListener(type, (event) => {
+      if (event.isTrusted) touched = true;
+    }, true);
+  }
+  const focusElement = HTMLElement.prototype.focus;
+  HTMLElement.prototype.focus = function focus(options?: FocusOptions): void {
+    if (touched) focusElement.call(this, options);
+  };
+  const focusWindow = window.focus;
+  window.focus = function focus(): void {
+    if (touched) focusWindow.call(window);
+  };
+}
